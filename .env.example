# --- PubMed (https://account.ncbi.nlm.nih.gov/settings/ -> API Key Management) ---
NCBI_EMAIL=you@example.com
NCBI_API_KEY=

# --- retrieval ---
ENCODER=medcpt            # medcpt | sbert | lsa
TOP_K=5
RRF_K=60
CANDIDATE_DEPTH=100
ABSTAIN_THRESHOLD=0.0     # tune on the eval set: min cosine of the best hit, below -> abstain
USE_RERANKER=0            # 1 = MedCPT cross-encoder rerank available to the API

# --- generation ---
LLM_BACKEND=ollama        # ollama | openai | extractive
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# any OpenAI-compatible API (Groq free tier shown; also OpenAI, Together, OpenRouter, vLLM)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-20b
# USD per 1M tokens of your chosen model, for cost-per-query reporting (0 for Ollama)
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0
